{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bicameral",
  "description": "Documentation for Bicameral's local governance runtime, hosted coordination, installation, security, and operations.",
  "colors": {
    "primary": "#0891B2",
    "light": "#22D3EE",
    "dark": "#8B5CF6"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "quickstart",
              "concepts/how-bicameral-works",
              "concepts/responsibility-boundary"
            ]
          },
          {
            "group": "Operate Bicameral",
            "pages": [
              "operations/installation",
              "operations/support",
              "operations/service-status",
              "operations/releases"
            ]
          }
        ]
      },
      {
        "tab": "Trust & Security",
        "groups": [
          {
            "group": "Security",
            "pages": [
              "trust/security",
              "trust/vulnerability-disclosure",
              "trust/compliance",
              "trust/shared-responsibility"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Install",
          "href": "https://install.bicameral-ai.com",
          "icon": "download"
        },
        {
          "anchor": "Application",
          "href": "https://app.bicameral-ai.com",
          "icon": "browser"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/BicameralAI",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@bicameral-ai.com"
      },
      {
        "label": "Security",
        "href": "mailto:devs@bicameral-ai.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install Bicameral",
      "href": "https://install.bicameral-ai.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/BicameralAI",
      "linkedin": "https://www.linkedin.com/company/bicameral-ai"
    }
  }
}
